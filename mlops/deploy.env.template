# MLOps Deployment Configuration
# Copy this file to deploy.env and fill in values as needed:
#   cp deploy.env.template deploy.env
#
# On Chameleon Jupyter, most defaults work out of the box.
# The only thing you MUST provide is GITHUB_TOKEN (for pushing branches).
# If clouds.yaml already exists from a previous run, Chameleon credentials
# are not needed either.

# ─── Chameleon credentials (optional if clouds.yaml already exists) ──────────
# Only needed to generate clouds.yaml for Terraform.
# If you already have mlops/tf/kvm/clouds.yaml from a previous run, skip these.
# Get from: Chameleon KVM@TACC -> Identity -> Application Credentials
CHAMELEON_CREDENTIAL_ID=""
CHAMELEON_CREDENTIAL_SECRET=""

# ─── Chameleon project (default works for your team) ─────────────────────────
OS_PROJECT_NAME="CHI-251409"

# ─── SSH key (defaults work on Chameleon Jupyter) ────────────────────────────
SSH_KEY_NAME="id_rsa_chameleon"
SSH_KEY_PATH="$HOME/.ssh/id_rsa_chameleon"

# ─── GitHub ──────────────────────────────────────────────────────────────────
GITHUB_REPO="https://github.com/SkullMag/mlops-project.git"

# ─── Resource naming ────────────────────────────────────────────────────────
TF_VAR_suffix="proj12"
LEASE_NAME="lease_mlops_proj12"
LEASE_DURATION_HOURS="12"
