# MLOps Deployment Configuration
# Copy this file to deploy.env and fill in your values:
#   cp deploy.env.template deploy.env
#
# DO NOT commit deploy.env — it contains secrets.

# ─── Required: Chameleon credentials ─────────────────────────────────────────
# Get these from: Chameleon KVM@TACC -> Identity -> Application Credentials
# Download the clouds.yaml and copy the values here.
CHAMELEON_CREDENTIAL_ID=""
CHAMELEON_CREDENTIAL_SECRET=""

# ─── Required: Chameleon project ─────────────────────────────────────────────
OS_PROJECT_NAME="CHI-251409"

# ─── Required: SSH key ───────────────────────────────────────────────────────
# Name of the key pair registered in Chameleon (Identity -> Key Pairs)
SSH_KEY_NAME="id_rsa_chameleon"
# Path to the corresponding private key on this machine
SSH_KEY_PATH="$HOME/.ssh/id_rsa_chameleon"

# ─── Required: GitHub repo ───────────────────────────────────────────────────
GITHUB_REPO="https://github.com/SkullMag/mlops-project.git"

# ─── Required: GitHub token (for pushing workflow-init branch) ───────────────
# Create at: GitHub -> Settings -> Developer settings -> Personal access tokens
# Needs 'repo' scope (or 'Contents: read/write' for fine-grained tokens)
GITHUB_TOKEN=""

# ─── Optional: Resource naming ───────────────────────────────────────────────
TF_VAR_suffix="proj12"

# ─── Optional: Lease settings ────────────────────────────────────────────────
LEASE_NAME="lease_mlops_proj12"
LEASE_DURATION_HOURS="12"

# ─── Optional: Service credentials (auto-generated if left empty) ────────────
# Leave empty to auto-generate random passwords.
# Set these only if you need reproducible credentials across deploys.
MINIO_ACCESS_KEY="minio-admin"
MINIO_SECRET_KEY=""
POSTGRES_USER="mlflow"
POSTGRES_PASSWORD=""
POSTGRES_DB="mlflowdb"
GRAFANA_PASSWORD=""
